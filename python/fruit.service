[Unit]
Description=FastAPI Service
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Techbleat-week-8/python
ExecStart=/bin/bash -c 'source .env/bin/activate && uvicorn main:app --host 0.0.0.0 --port 9000'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
